{
  "name": "functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions backend for Union Local Grievance Management",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed": "node lib/seed.js"
  },
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@union-local/shared": "file:../shared",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.3.2",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.13.9",
    "typescript": "^5.9.3"
  },
  "private": true
}
